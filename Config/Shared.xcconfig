// Shared build settings and identifiers for both app targets.
// Forks: change the identifiers below (and DEVELOPMENT_TEAM) and nothing else.
// After editing, no project regeneration is needed: the values are read at build time.

// --- Identity -------------------------------------------------------------------------------
TILDE_BUNDLE_PREFIX = app.tildessh
// Universal purchase: the same bundle identifier on iOS/iPadOS and macOS.
TILDE_BUNDLE_ID = $(TILDE_BUNDLE_PREFIX).Tilde
TILDE_CLOUDKIT_CONTAINER = iCloud.$(TILDE_BUNDLE_ID)
// Keychain access group = $(AppIdentifierPrefix)$(TILDE_KEYCHAIN_GROUP)
TILDE_KEYCHAIN_GROUP = $(TILDE_BUNDLE_PREFIX).shared

// --- Signing --------------------------------------------------------------------------------
// Left empty so forks and CI can build unsigned. Set your own team ID in Config/Local.xcconfig
// (git-ignored) or in Xcode's Signing & Capabilities.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// iCloud sync (CloudKit). NO runs the app on a local-only store, which is what unsigned and fork builds
// need (creating a CloudKit store without the iCloud entitlement can abort the process). Signed release
// builds set YES in Config/Local.xcconfig (git-ignored) or on the xcodebuild command line.
TILDE_CLOUDKIT_ENABLED = NO

// --- Versions -------------------------------------------------------------------------------
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// --- Toolchain ------------------------------------------------------------------------------
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
IPHONEOS_DEPLOYMENT_TARGET = 26.0
MACOSX_DEPLOYMENT_TARGET = 26.0
PRODUCT_NAME = Tilde
ENABLE_USER_SCRIPT_SANDBOXING = YES

// Optional per-developer overrides (git-ignored).
#include? "Local.xcconfig"
